/* pages/staff/staff.wxss */
/* 工作进度徽标 */
.prog-badge {
  margin-left: 10rpx;
  font-size: 20rpx; font-weight: 600;
  color: #1f6feb; background: #eaf0ff;
  border-radius: 999rpx; padding: 2rpx 14rpx;
  vertical-align: middle;
}
.prog-badge.full { color: #fff; background: #1c8a4f; }

.profile {
  display: flex; align-items: center; gap: 20rpx;
  background: linear-gradient(135deg, #1f6feb, #4d8bff);
  color: #fff; padding: 28rpx; border-radius: 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(31,111,235,0.25);
  margin-bottom: 24rpx;
}
.profile .avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25); color:#fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700;
}
.profile .name { font-size: 32rpx; font-weight: 600; }
.profile .muted { color: rgba(255,255,255,0.8); font-size: 24rpx; margin-top: 4rpx; }
.profile .mini-btn {
  margin-left: auto; background: rgba(255,255,255,0.18); color: #fff;
  font-size: 24rpx; border-radius: 12rpx; padding: 0 18rpx;
  height: 56rpx; line-height: 1;
  display: flex; align-items: center; justify-content: center;
}
.profile .mini-btn::after { border: none; }
.kpi-grid { display: flex; gap: 18rpx; margin-bottom: 30rpx; }
.kpi-grid .kpi {
  flex: 1; background: #fff; border-radius: 16rpx; padding: 22rpx;
  text-align: center; box-shadow: 0 2rpx 10rpx rgba(15,38,92,0.05);
}
.kpi-grid .kpi .num { font-size: 40rpx; font-weight: 700; color: #1f6feb; }
.kpi-grid .kpi .label { color: #6f7689; font-size: 24rpx; margin-top: 6rpx; }

.sync-bar {
  background: #fff; border-radius: 12rpx;
  padding: 14rpx 22rpx; margin-bottom: 20rpx;
  font-size: 22rpx; color: #6f7689;
  box-shadow: 0 2rpx 8rpx rgba(15,38,92,0.04);
}

/* 待办卡片 */
.todo-card { padding: 22rpx 24rpx; }
.chips { white-space: nowrap; margin: 6rpx 0 14rpx; }
.chip {
  display: inline-flex; align-items: center;
  padding: 10rpx 22rpx; margin-right: 14rpx;
  background: #f0f2f8; color: #6f7689;
  border-radius: 999rpx; font-size: 24rpx;
}
.chip.on { background: #1f6feb; color: #fff; font-weight: 600; }
.chip-n {
  margin-left: 8rpx; background: rgba(0,0,0,0.12);
  border-radius: 999rpx; padding: 0 10rpx; font-size: 20rpx;
}
.chip.on .chip-n { background: rgba(255,255,255,0.25); }

.todo-item {
  background: #f7f8fb; border-radius: 14rpx;
  padding: 18rpx 20rpx; margin-bottom: 14rpx;
}
.todo-item:active { background: #eef1f9; }
.todo-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.todo-name { font-size: 28rpx; font-weight: 600; flex: 1; }
.todo-date { font-size: 20rpx; color: #98a0b3; }
.todo-item .meta { font-size: 24rpx; color: #6f7689; line-height: 1.5; }

/* 修改密码弹窗 */
.pwd-modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; }
.pwd-mask { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
.pwd-panel {
  position: relative; width: 100%;
  background: #fff; border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}
.pwd-title { font-size: 34rpx; font-weight: 700; margin-bottom: 24rpx; }
.pwd-field { margin-bottom: 18rpx; }
.pwd-input {
  background: #f7f8fb;
  border: 1rpx solid #e3e6ee;
  border-radius: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
}
