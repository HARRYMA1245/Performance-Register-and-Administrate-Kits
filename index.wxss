/* pages/index/index.wxss */
.page { padding: 40rpx 28rpx 60rpx; }
.hero { text-align: center; padding: 30rpx 0 50rpx; }
.hero .logo {
  width: 130rpx; height: 130rpx; line-height: 130rpx;
  margin: 0 auto; background: #1f6feb; color: #fff;
  border-radius: 32rpx; font-size: 70rpx; box-shadow: 0 12rpx 28rpx rgba(31,111,235,0.35);
}
.hero-title { font-size: 44rpx; font-weight: 700; margin-top: 24rpx; }
.hero-sub { color: #8a93a6; font-size: 26rpx; margin-top: 10rpx; }

.login-field { margin-bottom: 18rpx; text-align: left; }
.login-input {
  background: #f7f8fb;
  border: 1rpx solid #e3e6ee;
  border-radius: 12rpx;
  height: 88rpx;              /* 显式高度,文字垂直居中且不被裁剪 */
  padding: 0 24rpx;           /* 只留左右 padding */
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
}
